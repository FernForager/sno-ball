{
  "name": "sno-ball",
  "private": true,
  "version": "0.1.0",
  "description": "Type a Washington address and read the history of that spot, from the house outward and from today back to the birth of the Earth.",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
